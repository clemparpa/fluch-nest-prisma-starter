{
  "name": "@fluch/api-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TS-Rest contracts + Zod schemas consumed by apps/api and clients.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fluch/tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  }
}
