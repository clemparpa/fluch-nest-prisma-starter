# Copy to `.env` (gitignored) before running `docker compose up`.
# Compose loads `.env` automatically from the project root.

# Postgres (used by the postgres service & DATABASE_URL below)
POSTGRES_USER=fluch
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=fluch

# App DB connection (points to the postgres service on the compose network)
DATABASE_URL=postgresql://fluch:changeme-strong-password@postgres:5432/fluch

# better-auth — secret must be >= 32 chars (cf. envSchema)
BETTER_AUTH_SECRET=change-me-to-a-real-secret-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
