{
  "name": "fluch-nest-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Template backend NestJS + Prisma + better-auth, production-ready.",
  "license": "MIT",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset": "prisma migrate reset --force && prisma db seed",
    "postinstall": "prisma generate",
    "prepare": "node scripts/prepare.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "prisma/schema.prisma": [
      "prisma format"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@thallesp/nestjs-better-auth": "^2.6.0",
    "better-auth": "^1.6.11",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.20.0",
    "prisma-zod-generator": "^2.1.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.23",
    "@swc/core": "^1.15.33",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.1",
    "typescript": "^5.5.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
}
